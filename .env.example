# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_PATH=./storage/agri_assistant.db
AUDIO_STORAGE_DIR=./storage/audio
AUDIO_RETENTION_HOURS=72

# Speech (ASR & TTS)
ASR_PROVIDER=auto            # auto | whisper | bhashini | mock
TTS_PROVIDER=auto            # auto | edge_tts | bhashini | macos_say | wav_tone
WHISPER_MODEL_SIZE=small
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Translation & LLM
TRANSLATOR_PROVIDER=glossary_hybrid   # glossary_hybrid | indictrans2 | llm
LLM_PROVIDER=auto                     # auto | openai_compat | ollama | extractive
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b

# Retrieval & Vector Store
EMBEDDING_PROVIDER=auto               # auto | sentence_transformers | char_ngram
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_STORE_BACKEND=sqlite           # sqlite | qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agri_kb

# Live Data Tools
MANDI_API_KEY=                        # Optional data.gov.in Agmarknet API key
WEATHER_PROVIDER=open_meteo           # open_meteo | fallback
LIVE_CACHE_TTL_SECONDS=1800

# WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN=sagveek_agri_verify_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# Safety & Confidence Gate
ASR_MIN_CONFIDENCE=0.55
RETRIEVAL_MIN_SCORE=0.28
FAITHFULNESS_MIN_SCORE=0.35
KISAN_CALL_CENTRE=1800-180-1551
